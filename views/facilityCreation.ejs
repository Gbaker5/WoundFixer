<%- include('partials/header') -%>
  <div class="newWoundcontainer">
    <div class="shadow2">
      <div class="row">

          <section class="blacktop navbar row col-12">
      <div class="profileNav-ct"> <!--3 divs flexed into three columns-->
      
        <div class="whitetext topdiv">
          <p><strong>Welcome:</strong> <%=user.userName%></p>
          <p><strong>Access Level:</strong> <%= user.role[0].toUpperCase()%><%=user.role.substring(1)%></p>

         
        </div>

       <% if (user.role === "manager" || user.role === "admin") { %>
        <div class="allwoundsHeader profilemiddiv-Admin whitetext"> <!--Two divs flexed into a column-->
          <h2>Profile</h2>
        </div>
       <%} else {%>
        <div class="allwoundsHeader profilemiddiv whitetext"> <!--Two divs flexed into a column-->
          <h2>Profile</h2>
        </div>
       <%}%>
       


        <% if (user.role === "manager" || user.role === "admin") { %>
          <div class="profileendiv-Admin">
            <p class="underline whitetext"><strong>Admin and Manager Access:</strong></p>
            <div class="adminBox">
              <a href="/facilityCreation" class="btn bluebutton">Facility Creation</a>
              <a href="/logout" class="btn bluebutton">Logout</a>
              <a href="/physicianP" class="btn bluebutton">Physician Page</a>
              <a href="/editRoles" class="btn bluebutton">Role Edit</a>
              <a href="/editUsers" class="btn bluebutton">Delete Users</a>
            </div>
          </div>
        <% } else { %>
          <div class="profileendiv">
            <a href="/logout" class="btn bluebutton">Logout</a>
          </div>
        <% } %>
        
      </div>

     <!-- MOBILE NAV (HIDDEN ON DESKTOP) -->
<div class="profile-mobile-nav">
  <div class="mobile-title">Facility Creation</div>
  <div class="mobile-menu-icon" onclick="toggleMobileMenuProfile()">☰</div>
</div>

<!-- DROPDOWN MENU FOR MOBILE -->
<div id="profile-mobile-dropdown">
  <a href="/logout" class="btn bluebutton">Logout</a>
  <% if (user.role === "manager" || user.role === "admin") { %>
    <a href="/physicianP" class="btn bluebutton">Physician Page</a>
    <a href="/editRoles" class="btn bluebutton">Role Edit</a>
    <a href="/editUsers" class="btn bluebutton">Delete Users</a>
  <% } %>
</div>

   

    </section>

    <section id="facilityInputs">
        <div class="avail-ct col-4" > <!--Check for availability of facility Code first (use json to update or search in page no refresh)-->

      
          <div>
            <label for="">Facilty Code Search: Is this available?</label>
            <input 
            type="text" 
            id="facilityCode"
            placeholder="Enter facility ID code">
          </div>
          
     

        <div class="availability-ct">
         <span>Result: </span> <p id="availability"> </p>
        </div>
        
        </div>

        <div class="facilitycreate-ct col-6"> <!--Create facility -->
          <p>Facility Information Input</p>
             <form action="/facilityCreation" method="POST">
                <div>
                    <label for="">Name</label>     
                    <input type="text" class="" id="" name="facilityName">           
                </div>
                <div>
                    <label for="">Address</label>     
                    <input type="text" class="form-control" id="" name="facilityAddress">           
                </div>
                <div>
                    <label for="">Phone Number</label>     
                    <input type="text" class="form-control" id="" name="facilityPhone">           
                </div>
                <div>
                    <label for="">City</label>     
                    <input type="text" class="form-control" id="" name="facilityCity">           
                </div>
                <div>
                    <label for="">State</label>     
                    
                    <select class="form-control" name="facilityState" id="">
                      <option value="">---</option>
                      <option value="Oklahoma">Oklahoma</option>
                    </select>           
                </div>
                <div>
                    <label for="">Zipcode</label>     
                    <input type="text" class="form-control" id="" name="facilityZipcode">           
                </div>
                <div>
                    <label for="">Facility Code</label>     
                    <input type="text" class="form-control" id="" name="facilityIdCode">           
                </div>

                <button type="submit" class="btncolor btn btn-primary">Create</button>
            </form>
        </div>
    </section>
       







      </div>
      </div>  
</div>

<%- include('partials/footer') -%>
